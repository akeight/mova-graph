# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# Upstash Redis (AI rate limiting)
# Server-only. Required in production so paid AI routes cannot run unprotected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase PostgreSQL
DATABASE_URL=
DIRECT_URL=

# Supabase Auth (required)
# Project URL and publishable (anon) key from Supabase → Project Settings → API.
# Enable Email auth and disable "Confirm email" for instant sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Development-only convenience: signing in with this email seeds the demo
# profile instead of an empty one. Ignored in production builds.
NEXT_PUBLIC_DEV_ACCOUNT_EMAIL=